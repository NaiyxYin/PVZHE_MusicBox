<Project>

  <!-- 宿主程序集（游戏提供的托管 DLL）由开发者自己准备，仓库既不携带也不猜任何本机路径。
       指定含 PlantsVsZombies.dll 与 GodotSharp.dll 的那个目录，两种写法任选：
         dotnet build ... -p:PVZHostDir="<该目录>"
         设环境变量 PVZHOSTDIR=<该目录> 之后直接构建
       取法见 README「构建与打包」。 -->
  <PropertyGroup>
    <PVZHostDir Condition="'$(PVZHostDir)' == ''">$(PVZHOSTDIR)</PVZHostDir>
    <!-- 模组本体默认不带走宿主 DLL；离线工具要在运行时加载宿主类型时才设成 true。 -->
    <PVZHostRefCopyLocal Condition="'$(PVZHostRefCopyLocal)' == ''">false</PVZHostRefCopyLocal>
  </PropertyGroup>

  <ItemGroup Condition="'$(NeedsPVZHostRefs)' == 'true'">
    <Reference Include="PlantsVsZombies">
      <HintPath>$(PVZHostDir)\PlantsVsZombies.dll</HintPath>
      <Private>$(PVZHostRefCopyLocal)</Private>
    </Reference>
    <Reference Include="GodotSharp">
      <HintPath>$(PVZHostDir)\GodotSharp.dll</HintPath>
      <Private>$(PVZHostRefCopyLocal)</Private>
    </Reference>
  </ItemGroup>

  <!-- 早于引用解析失败，免得冒出一堆看不懂的 CS0246。 -->
  <Target Name="RequirePVZHostDir" BeforeTargets="BeforeResolveReferences" Condition="'$(NeedsPVZHostRefs)' == 'true'">
    <Error Condition="'$(PVZHostDir)' == ''"
           Text="没有指定宿主程序集目录：用 -p:PVZHostDir=&lt;目录&gt; 或环境变量 PVZHOSTDIR 指向含 PlantsVsZombies.dll / GodotSharp.dll 的目录，取法见 README「构建与打包」。" />
    <Error Condition="'$(PVZHostDir)' != '' and !Exists('$(PVZHostDir)\PlantsVsZombies.dll')"
           Text="$(PVZHostDir) 下没有 PlantsVsZombies.dll：请把 PVZHostDir 指到那两个 DLL 真正所在的目录。" />
    <Error Condition="'$(PVZHostDir)' != '' and !Exists('$(PVZHostDir)\GodotSharp.dll')"
           Text="$(PVZHostDir) 下没有 GodotSharp.dll：同上。" />
  </Target>

</Project>
