<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0</TargetFramework>
    <Nullable>disable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>ProbeFormats</AssemblyName>
    <EnableDynamicLoading>true</EnableDynamicLoading>
    <!-- 宿主程序集引用与 PVZHostDir 检查见 ../Directory.Build.props；
         这个工具要在运行时加载宿主类型，所以把 DLL 拷到输出目录。 -->
    <NeedsPVZHostRefs>true</NeedsPVZHostRefs>
    <PVZHostRefCopyLocal>true</PVZHostRefCopyLocal>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="ModAssembly">
      <HintPath>..\bin\Release\ModAssembly.dll</HintPath>
    </Reference>
  </ItemGroup>
</Project>
